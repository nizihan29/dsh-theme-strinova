{
  "name": "dsh-theme-strinova",
  "version": "0.1.0",
  "description": "卡拉彼丘（Calabiyau / Strinova）双模式主题（浅色/深色）—— 暖琥珀金配色，含角色卡轮换、漂浮粒子与自定义素材",
  "author": "nizihan29",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nizihan29/dsh-theme-strinova.git"
  },
  "homepage": "https://github.com/nizihan29/dsh-theme-strinova#readme",
  "bugs": {
    "url": "https://github.com/nizihan29/dsh-theme-strinova/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "strinova"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets/screenshot.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
